cabal-version: 3.4
name: ghc-ui
version: 0.1
synopsis: Terminal UI for ghc-server
license: MIT
build-type: Simple

common all
  ghc-options: -Wall -Widentities -Wincomplete-uni-patterns -Wmissing-deriving-strategies -Wredundant-constraints -Wunused-type-patterns -Wunused-packages
  default-language: GHC2021
  default-extensions:
    BlockArguments,
    DataKinds,
    DerivingStrategies,
    DuplicateRecordFields,
    LambdaCase,
    NamedFieldPuns,
    NoFieldSelectors,
    OverloadedLabels,
    OverloadedLists,
    OverloadedRecordDot,
    OverloadedStrings,
    QuasiQuotes,
    RecordWildCards,
    StrictData,
    TemplateHaskell,
    TypeFamilies
  build-depends:
    base ==4.*

library
  import: all
  hs-source-dirs: lib
  exposed-modules:
    Ghc.Ui.Attr
    Ghc.Ui.App
    Ghc.Ui.Data.Main
    Ghc.Ui.Data.Session
    Ghc.Ui.Data.Sessions
    Ghc.Ui.Data.ServerApi
    Ghc.Ui.Data.Tasks
    Ghc.Ui.Data.Name
    Ghc.Ui.Data.WorkerId
    Ghc.Ui.Event.Main
    Ghc.Ui.Event.Popup
    Ghc.Ui.Event.Session
    Ghc.Ui.Event.Sessions
    Ghc.Ui.Event.Tasks
    Ghc.Ui.Render.Format
    Ghc.Ui.GhcDebug
    Ghc.Ui.Grpc
    Ghc.Ui.ModuleSelector
    Ghc.Ui.Render.Main
    Ghc.Ui.Render.Popup
    Ghc.Ui.Render.Session
    Ghc.Ui.Render.Sessions
    Ghc.Ui.Render.Tasks
    Ghc.Ui.Run
    Ghc.Ui.Utils
  build-depends:
    binary,
    brick,
    buck-worker-internal,
    buck-worker-proto,
    buck-worker-types,
    bytestring,
    containers,
    generic-lens,
    ghc-debug-brick,
    directory,
    filepath,
    fsnotify,
    grapesy,
    lens,
    microlens-platform,
    text,
    time,
    transformers,
    vty

executable ghc-ui
  main-is: Main.hs
  hs-source-dirs: app
  ghc-options:
    -threaded -rtsopts -with-rtsopts=-N -O2
  build-depends:
    ghc-ui

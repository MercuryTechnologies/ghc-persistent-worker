cabal-version:      3.4
name:               buck-worker-internal
version:            0.1.0.0
license:            MIT
license-file:       LICENSE
author:             Ian-Woo Kim
maintainer:         ianwookim@gmail.com
category:           Development
build-type:         Simple
extra-doc-files:    CHANGELOG.md

flag mwb
    description: Use mwb-customized GHC from January 2026
    manual: True
    default: False

flag downsweep-cache
    description: GHC contains the patch for using an old module graph as a cache for downsweep
    manual: True
    default: False

flag unit-index
    description: GHC contains the patch for the abstraction of parts of the unit state
    manual: True
    default: False

flag fixed-nodes
    description: GHC contains the patch for fixed module graph ndoes
    manual: True
    default: False

flag linkables
  description: GHC contains patch for abstract getLinkDeps
  manual: True
  default: False

common all
  ghc-options: -Wall -Widentities -Wincomplete-uni-patterns -Wmissing-deriving-strategies -Wredundant-constraints -Wunused-type-patterns -Wunused-packages
  default-language: GHC2021
  default-extensions:
    BlockArguments,
    DataKinds,
    DerivingStrategies,
    DuplicateRecordFields,
    LambdaCase,
    NamedFieldPuns,
    NoFieldSelectors,
    OverloadedLabels,
    OverloadedLists,
    OverloadedRecordDot,
    OverloadedStrings,
    QuasiQuotes,
    RecordWildCards,
    StrictData,
    TypeFamilies
  build-depends:
    base ==4.*

  if (flag(mwb))
      cpp-options: -DMWB -DDOWNSWEEP_CACHE -DUNIT_INDEX

  if (flag(downsweep-cache))
      cpp-options: -DDOWNSWEEP_CACHE

  if (flag(unit-index))
      cpp-options: -DUNIT_INDEX

  if (flag(fixed-nodes) || impl(ghc >= 9.14))
      cpp-options: -DFIXED_NODES

  if (flag(linkables))
      cpp-options: -DLINKABLES

library
    import: all
    hs-source-dirs:   src
    exposed-modules:  Internal.AbiHash
                      Internal.BuildPlan
                      Internal.BuildPlan.External
                      Internal.BuildPlan.Incremental
                      Internal.BuildPlan.Json
                      Internal.Cache.Hpt
                      Internal.Cache.Metadata
                      Internal.Compat.FixedNodes
                      Internal.Compat.GHC914
                      Internal.Compat.LinkDeps
                      Internal.Compat.UnitIndex
                      Internal.Compile.Make
                      Internal.Debug
                      Internal.DynFlags
                      Internal.DynFlags.Options
                      Internal.DynFlags.Parse
                      Internal.DynFlags.Update
                      Internal.Env
                      Internal.Error
                      Internal.Json
                      Internal.Log
                      Internal.Metadata
                      Internal.Metadata.Static
                      Internal.Session
                      Internal.State
                      Internal.State.Make
                      Internal.State.Stats
                      Internal.State.UnitIndex
                      Internal.State.UnitIndex.Update

    build-depends:    aeson,
                      async,
                      base >= 4.20,
                      buck-worker-types,
                      containers,
                      directory,
                      exceptions,
                      extra,
                      bytestring,
                      flatparse,
                      filepath,
                      file-io,
                      ghc,
                      ghc-boot,
                      hashable,
                      text,
                      time,
                      transformers
    default-language: GHC2021
    default-extensions:
      BlockArguments,
      DerivingStrategies,
      DuplicateRecordFields,
      LambdaCase,
      NoFieldSelectors,
      OverloadedRecordDot,
      RecordWildCards,
      StrictData

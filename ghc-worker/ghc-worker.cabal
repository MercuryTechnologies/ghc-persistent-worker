cabal-version: 2.2
name: ghc-worker
version: 0.1
synopsis: GHC persistent worker through gRPC connection
license: MIT
license-file: LICENSE
build-type: Simple

flag debug
    description: Compiled with debug mode. Dump all on failure
    manual: True
    default: False

flag mwb
    description: Use mwb-customized GHC from January 2026
    manual: True
    default: False

flag ghc-debug
  description: Build with support for ghc-debug
  manual: True
  default: False

common all
  ghc-options: -Wall -Widentities -Wincomplete-uni-patterns -Wmissing-deriving-strategies -Wredundant-constraints -Wunused-type-patterns -Wunused-packages
  default-language: GHC2021
  default-extensions:
    BlockArguments,
    DataKinds,
    DerivingStrategies,
    DuplicateRecordFields,
    LambdaCase,
    NamedFieldPuns,
    NoFieldSelectors,
    OverloadedLabels,
    OverloadedLists,
    OverloadedRecordDot,
    OverloadedStrings,
    QuasiQuotes,
    RecordWildCards,
    StrictData,
    TypeFamilies
  build-depends:
    base ==4.*

  if (flag(mwb))
      cpp-options: -DMWB -DDOWNSWEEP_CACHE -DUNIT_INDEX

library
  import: all
  ghc-options: -O2
  hs-source-dirs: lib
  exposed-modules:
    GhcWorker.CompileResult
    GhcWorker.GhcHandler
    GhcWorker.Grpc
    GhcWorker.Instrumentation
    GhcWorker.Orchestration
    GhcWorker.Run
  build-depends:
    async,
    binary,
    buck-worker-grpc,
    buck-worker-internal,
    buck-worker-proto,
    buck-worker-types,
    bytestring,
    containers,
    deepseq,
    directory,
    file-io,
    ghc,
    grapesy >=1.0.1,
    optparse-applicative,
    os-string,
    process,
    text
  if (flag(ghc-debug))
    build-depends:
       ghc-debug-stub
    ghc-options: -DGHC_DEBUG

  if (flag(debug))
      cpp-options: -D__DEBUG__

executable ghc-worker
  import: all
  main-is: Main.hs
  hs-source-dirs: app/ghc-worker
  if os(linux) && arch(x86_64)
      ghc-options: -O2 -threaded "-with-rtsopts=-K512M -I5 -A128M -T -N -xm40000000 -xp"
  else
      ghc-options: -O2 -threaded "-with-rtsopts=-K512M -I5 -A128M -T -N"
  build-depends:
    ghc-worker

test-suite ghc-worker-test
  import: all
  type: exitcode-stdio-1.0
  main-is: Main.hs
  hs-source-dirs: test
  other-modules:
    BuildPlanTest.Test1,
    BuildPlanTest.Test2,
    BuildThTest,
    FlagParserTest,
    Incremental.BuildTest,
    Incremental.Flow,
    Incremental.FlowData,
    Incremental.FlowTest,
    InterfacePathTest,
    ProjectBuildTest,
    Resource.Measure,
    Resource.BasicTest,
    Resource.LazyByteCodeTest,
    ScheduleTest
  ghc-options: -threaded -rtsopts "-with-rtsopts=-N -T"
  build-depends:
    aeson,
    buck-worker-internal,
    buck-worker-types,
    bytestring,
    containers,
    directory,
    exceptions,
    extra,
    file-io,
    filepath,
    ghc,
    ghc-boot,
    ghc-paths,
    ghc-worker-test-common,
    hedgehog >= 1.5,
    monad-control,
    tasty,
    tasty-hedgehog,
    text,
    transformers

default_language = "GHC2021"

default_extensions = [
    "BlockArguments",
    "DataKinds",
    "DeriveAnyClass",
    "DerivingStrategies",
    "DuplicateRecordFields",
    "LambdaCase",
    "NamedFieldPuns",
    "OverloadedLists",
    "OverloadedRecordDot",
    "OverloadedStrings",
    "RecordWildCards",
    "StrictData",
    "TypeFamilies",
]

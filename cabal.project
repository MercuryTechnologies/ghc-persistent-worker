packages: ./buck-proxy
          ./ghc-worker
          ./grpc
          ./instrument
          ./internal
          ./proto
          ./test-common
          ./types

tests: true

-- For MWB-customized GHC, turn this on.
-- flags: +mwb

package ghc-worker
  executable-dynamic: true

package buck-worker-internal
  executable-dynamic: true

allow-newer:
  proto-lens:*
  , *:containers
  , *:bytestring
  , ghc-debug-brick:*
  , tasty-hedgehog:hedgehog

if (impl(ghc >= 9.11))
  allow-newer:
    time,
  constraints:
    extra == 1.8


cabal-version: 2.2
name: ghc-proxy
version: 0.1
synopsis: GHC proxy executable for Buck
license: MIT
license-file: LICENSE
build-type: Simple

common all
  ghc-options: -Wall -Widentities -Wincomplete-uni-patterns -Wmissing-deriving-strategies -Wredundant-constraints -Wunused-type-patterns -Wunused-packages
  default-language: GHC2021
  default-extensions:
    BlockArguments,
    DataKinds,
    DerivingStrategies,
    DuplicateRecordFields,
    LambdaCase,
    NamedFieldPuns,
    NoFieldSelectors,
    OverloadedLabels,
    OverloadedLists,
    OverloadedRecordDot,
    OverloadedStrings,
    QuasiQuotes,
    RecordWildCards,
    StrictData,
    TypeFamilies
  build-depends:
    base ==4.*

executable ghc-proxy
  import: all
  main-is: Main.hs
  hs-source-dirs: app/ghc-proxy
  ghc-options: -O2 -threaded "-with-rtsopts=-K512M -I5 -A128M -T -N"
  build-depends:
    buck-worker-internal,
    buck-worker-types

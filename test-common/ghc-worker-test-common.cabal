cabal-version: 2.2
name: ghc-worker-test-common
version: 0.1
license: MIT
license-file: LICENSE
author: Ian-Woo Kim
maintainer: ianwookim@gmail.com
category: Development
build-type: Simple

common all
  ghc-options: -Wall -Widentities -Wincomplete-uni-patterns -Wmissing-deriving-strategies -Wredundant-constraints -Wunused-type-patterns -Wunused-packages
  default-language: GHC2021
  default-extensions:
    BlockArguments,
    DataKinds,
    DerivingStrategies,
    DuplicateRecordFields,
    LambdaCase,
    NamedFieldPuns,
    NoFieldSelectors,
    OverloadedLabels,
    OverloadedLists,
    OverloadedRecordDot,
    OverloadedStrings,
    QuasiQuotes,
    RecordWildCards,
    StrictData,
    TypeFamilies
  build-depends:
    base ==4.*

library
  import: all
  hs-source-dirs: lib
  exposed-modules:
    Test.Build
    Test.BuildSystem
    Test.Cache
    Test.Data.BuildSystem
    Test.Data.Env
    Test.Data.Project
    Test.Data.ProjectBuild
    Test.Data.Scheduler
    Test.Data.SourceMode
    Test.Data.TestLog
    Test.Env
    Test.Gen.Project
    Test.Gen.ProjectBuild
    Test.Gen.Resume
    Test.Log
    Test.PackageDb
    Test.Path
    Test.ProjectBuild.Classify
    Test.ProjectBuild.Property
    Test.Resume
    Test.Run
    Test.Scheduler
    Test.Source
    Test.Target
  build-depends:
    aeson,
    async,
    buck-worker-internal,
    buck-worker-types,
    bytestring,
    containers,
    directory,
    file-io,
    filepath,
    extra,
    generic-lens,
    ghc,
    ghc-paths,
    hedgehog,
    lens,
    mtl,
    tasty,
    tasty-hedgehog,
    temporary,
    text,
    time,
    typed-process
